# --- API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://msl:msl@localhost:5432/msl
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ID_ENCRYPTION_KEY=
ID_HASH_KEY=
# Public URL of the app (share links). On Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN
WEB_ORIGIN=http://localhost:5173
# 2FA (authenticator code at sign-in) is off. Set to true to require it for everyone.
REQUIRE_2FA=false

# --- Photo storage ---
# Development: photos go to UPLOAD_DIR on disk.
UPLOAD_DIR=./uploads
# Production: Cloudflare R2 (required when NODE_ENV=production). Setting R2_BUCKET switches to R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=msl-photos
