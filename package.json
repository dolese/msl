{
  "name": "msl",
  "private": true,
  "description": "MSL \u2014 secure person registry (API + web, TypeScript monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @msl/api & npm run dev --workspace @msl/web",
    "build": "npm run build --workspace @msl/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @msl/api",
    "db:seed": "npm run db:seed --workspace @msl/api",
    "start": "npm run start --workspace @msl/api"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
